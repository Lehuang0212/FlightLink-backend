# API runtime paths. Create these directories under /var/lib/flightlink.
FLIGHTLINK_DATA_DIR=/var/lib/flightlink
FLIGHTLINK_DATABASE_PATH=/var/lib/flightlink/flightlink.sqlite3
FLIGHTLINK_ROUTER_CONFIG_DIR=/var/lib/flightlink/router-configs
FLIGHTLINK_CAPTURE_CONFIG_DIR=/var/lib/flightlink/capture-configs
FLIGHTLINK_CAPTURE_DIR=/var/lib/flightlink/captures

# Host systemd integration. The API must run as flightlink-api, not root.
FLIGHTLINK_ROUTER_MANAGER=systemd
FLIGHTLINK_ROUTER_CONTROL_HELPER=/usr/local/sbin/flightlink-routerctl
FLIGHTLINK_SUDO_PATH=/usr/bin/sudo
FLIGHTLINK_ROUTER_COMMAND_TIMEOUT_SECONDS=10

# PCAP rotation and retention defaults: 10-minute segments, 24-hour retention,
# 1 GiB target directory size, and a 5-minute cleanup interval.
FLIGHTLINK_PCAP_ROTATE_SECONDS=600
FLIGHTLINK_PCAP_RETENTION_SECONDS=86400
FLIGHTLINK_PCAP_MAX_BYTES=1073741824
FLIGHTLINK_PCAP_CLEANUP_INTERVAL_SECONDS=300

# The first management access is through an SSH local-forward over HTTP.
# Set this to true when the management UI/API is served through HTTPS.
FLIGHTLINK_SESSION_COOKIE_NAME=flightlink_session
FLIGHTLINK_SESSION_TTL_SECONDS=43200
FLIGHTLINK_SESSION_COOKIE_SECURE=false

# Alibaba Cloud ECS security-group integration. Attach the instance RAM role
# to this ECS; do not put long-lived AccessKey credentials here.
FLIGHTLINK_SECURITY_GROUP_PROVIDER=aliyun
FLIGHTLINK_ALIYUN_REGION_ID=replace-with-your-region-id
FLIGHTLINK_ALIYUN_SECURITY_GROUP_ID=replace-with-your-security-group-id
# Optional. Remove or leave blank to use ECS instance-role auto-discovery.
FLIGHTLINK_ALIYUN_ECS_ROLE_NAME=
FLIGHTLINK_ALIYUN_UAV_SOURCE_CIDRS=0.0.0.0/0
FLIGHTLINK_ALIYUN_GCS_SOURCE_CIDRS=replace-with-qgc-public-ip/32
FLIGHTLINK_ALIYUN_API_TIMEOUT_SECONDS=10
