[Unit]
Description=FlightLink ECS 1.0 Control & Read API (passive, no systemd/SG write privileges)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flightlink-api
Group=flightlink
WorkingDirectory=/var/lib/flightlink
EnvironmentFile=-/etc/flightlink/flightlink.env
ExecStart=/opt/flightlink/venv/bin/flightlink-api
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/flightlink
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
